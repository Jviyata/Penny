# Copy to .env.local for local dev. On Vercel, set this in Project Settings → Environment Variables.
ANTHROPIC_API_KEY=

# Penny's voice (ElevenLabs). Without a key, Penny falls back to the phone's built-in voice.
ELEVENLABS_API_KEY=
# Optional: which ElevenLabs voice and model Penny uses.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
